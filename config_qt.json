{
  "app": {
    "dark_theme": true,
    "target_fps": 60,
    "overlay_enabled": true,
    "mock_telemetry": false,
    "hud_debug_boxes": false,
    "delta_reference_mode": "all_time_best",
    "delta_freeze_duration": 3.5,
    "delta_ema_samples": 0
  },
  "plugins_enabled": {
    "simpad.builtin.gear_speed_hud": false,
    "simpad.builtin.pedal_monitor": false
  },
  "plugins": {
    "simpad.builtin.race_engineer": {
      "master_enabled": true,
      "muted": false,
      "subplugin_configs": {
        "fight_spotter": {
          "enabled": false,
          "priority": 120,
          "car_length_m": 4.2,
          "car_width_m": 1.9,
          "gap_needed_for_clear_m": 1.5,
          "clear_message_delay_sec": 0.35,
          "repeat_hold_freq_sec": 3.0,
          "min_speed_kmh": 20.0,
          "max_closing_speed_kmh": 90.0,
          "use_oval_logic": false,
          "enable_three_wide": true
        },
        "pitlane_spotter": {
          "enabled": true,
          "priority": 110,
          "enable_unsafe_release": true,
          "unsafe_release_distance_m": 28.0,
          "unsafe_release_ttc_sec": 2.5,
          "enable_pit_traffic_ahead": true,
          "pit_slow_ahead_distance_m": 35.0,
          "enable_pit_overlap": true,
          "pit_slow_speed_threshold_kmh": 20.0
        },
        "pace_notes": {
          "enabled": true,
          "priority": 100,
          "enable_brake": true,
          "enable_turn_in": true,
          "enable_turn": true,
          "enable_gear": true,
          "anticipation_time_sec": 0.8,
          "min_lead_distance_m": 15.0,
          "max_lead_distance_m": 75.0
        },
        "traffic_spotter": {
          "enabled": true,
          "priority": 90,
          "enable_ref_lap_filter": true,
          "domain_speed_tolerance_kmh": 30.0,
          "speed_delta_min_kmh": 20.0,
          "ttc_trigger_sec": 5.0,
          "target_memory_sec": 6.0,
          "overlap_dist_threshold_m": 4.0,
          "clear_dist_threshold_m": 10.0,
          "max_scan_distance_m": 250.0,
          "abort_ttc_sec": 6.0,
          "phrase_mode": "alongside"
        },
        "traffic_jam": {
          "enabled": true,
          "priority": 80,
          "enable_ref_lap_filter": true,
          "domain_speed_tolerance_kmh": 30.0,
          "slow_speed_threshold_kmh": 40.0,
          "warning_distance_m": 180.0,
          "cooldown_sec": 8.0
        },
        "lap_validity": {
          "enabled": true,
          "priority": 70,
          "busy_duration_sec": 1.8,
          "announce_investigation": true,
          "announce_cleared": true,
          "announce_penalty": true,
          "use_actionable_prompt": true
        }
      },
      "subplugin_order": [
        "fight_spotter",
        "pitlane_spotter",
        "pace_notes",
        "traffic_spotter",
        "traffic_jam",
        "lap_validity"
      ]
    }
  }
}