          "max_scan_distance_m": 250.0,
          "abort_ttc_sec": 6.0,
          "phrase_mode": "alongside"
        },
        "fight_spotter": {
          "car_length_m": 4.2,
          "car_width_m": 1.9,
          "gap_needed_for_clear_m": 1.5,
          "clear_message_delay_sec": 0.35,
          "repeat_hold_freq_sec": 3.0,
          "min_speed_kmh": 35.0,
          "max_closing_speed_kmh": 90.0,
          "use_oval_logic": false,
          "enable_three_wide": true
