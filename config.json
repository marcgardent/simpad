{
  "app": {
    "dark_theme": true,
    "target_fps": 60,
    "overlay_enabled": true,
    "mock_telemetry": false,
    "hud_debug_boxes": false,
    "delta_reference_mode": "all_time_best",
    "delta_freeze_duration": 3.5,
    "delta_ema_samples": 0,
    "abs_threshold": 0.15,
    "tc_threshold": 0.2,
    "lateral_slide_threshold": 0.1,
    "udp_host": "127.0.0.1",
    "udp_port": 5000,
    "update_rate_hz": 100,
    "studio_eco_mode": true,
    "studio_eco_idle_delay_sec": 2.0
  },
  "game_plugin": {
    "target_ip": "127.0.0.1",
    "target_port": 5000,
    "inbound_port": 5001,
    "enable_logging": true,
    "rates": {
      "PlayerTelemetryRate": "unlimited",
      "OpponentTelemetryRate": "off",
      "CompactScoringRate": "10Hz",
      "FullScoringRate": "10Hz",
      "WeatherRate": "1Hz",
      "ExtendedStateRate": "10Hz",
      "ForceFeedbackRate": "off",
      "GraphicsRate": "off",
      "TrackRulesRate": "off",
      "PitMenuRate": "off",
      "SystemEvents": "Enabled"
    }
  },
  "loggers": {
    "telemetry": true,
    "engineer": true,
    "schedule": true,
    "haptics": true,
    "gui": true,
    "utils": true,
    "track_limits": true,
    "overlay_anomaly": true,
    "delta_debug": true,
    "sector_eval": true,
    "sector_paint": true
  },
  "plugins_enabled": {
    "simpulse.builtin.race_engineer": true,
    "simpulse.builtin.pedal_monitor": false,
    "simpulse.builtin.gear_speed_hud": false
  },
  "plugins": {
    "simpulse.builtin.race_engineer": {
      "master_enabled": true,
      "muted": false,
      "subplugin_configs": {
        "traffic_spotter": {
          "enable_ref_lap_filter": true,
          "domain_speed_tolerance_kmh": 30.0,
          "speed_delta_min_kmh": 20.0,
          "ttc_trigger_sec": 5.0,
          "target_memory_sec": 6.0,
          "overlap_dist_threshold_m": 4.0,
          "clear_dist_threshold_m": 10.0,
          "max_scan_distance_m": 250.0,
          "abort_ttc_sec": 6.0,
          "phrase_mode": "alongside"
        },
        "fight_spotter": {
          "car_length_m": 4.2,
          "car_width_m": 1.9,
          "gap_needed_for_clear_m": 1.5,
          "clear_message_delay_sec": 0.35,
          "repeat_hold_freq_sec": 3.0,
          "min_speed_kmh": 35.0,
          "max_closing_speed_kmh": 90.0,
          "use_oval_logic": false,
          "enable_three_wide": true
        },
        "pitlane_spotter": {
          "enable_unsafe_release": true,
          "unsafe_release_distance_m": 28.0,
          "unsafe_release_ttc_sec": 2.5,
          "enable_pit_traffic_ahead": true,
          "pit_slow_ahead_distance_m": 35.0,
          "enable_pit_overlap": true,
          "hazard_cooldown_sec": 4.0,
          "pit_slow_speed_threshold_kmh": 20.0
        },
        "pace_notes": {
          "enable_brake": false,
          "enable_turn_in": false,
          "enable_turn": false,
          "enable_gear": true,
          "anticipation_time_sec": 0.2,
          "min_lead_distance_m": 20.0,
          "max_lead_distance_m": 75.0
        },
        "traffic_jam": {
          "enable_ref_lap_filter": true,
          "domain_speed_tolerance_kmh": 30.0,
          "slow_speed_threshold_kmh": 50.0,
          "warning_distance_m": 180.0,
          "cooldown_sec": 8.0
        },
        "lap_validity": {
          "busy_duration_sec": 1.8
        }
      },
      "subplugin_order": [
        "traffic_spotter",
        "fight_spotter",
        "pitlane_spotter",
        "pace_notes",
        "traffic_jam",
        "lap_validity"
      ]
    },
